# Copy to .env (git-ignored) and fill in only the keys you have. Never commit .env.

# Claude (Anthropic API) - used by the `claude` entry in config.yaml
ANTHROPIC_API_KEY=

# Gemini - set ONE of these, or leave both empty to use Vertex AI with
# `gcloud auth application-default login` (project from GOOGLE_CLOUD_PROJECT or config.yaml)
GEMINI_API_KEY=
VERTEX_API_KEY=
GOOGLE_CLOUD_PROJECT=

# OpenAI API - used by the `gpt` entry. For the local gpt-oss model via Ollama instead, set
# OPENAI_BASE_URL=http://localhost:11434/v1 and OPENAI_API_KEY=ollama, and do not use `gpt` in the same run.
OPENAI_API_KEY=
