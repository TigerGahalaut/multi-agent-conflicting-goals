# ==============================================================================
# Environment Configuration Template
# Copy this file to .env and fill in your keys: cp .env.example .env
# (.env is in .gitignore and will never be pushed to GitHub)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Gemini (Choose Option A or Option B)
# ------------------------------------------------------------------------------
# Option A: Google AI Studio API Key (Easiest - get key from https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Option B: Google Cloud Vertex AI (Requires gcloud auth application-default login)
# GOOGLE_CLOUD_PROJECT=your_gcp_project_id_here
# GOOGLE_CLOUD_LOCATION=global

# ------------------------------------------------------------------------------
# 2. Anthropic Claude (Required for claude-haiku-5-5)
# ------------------------------------------------------------------------------
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ------------------------------------------------------------------------------
# 3. OpenAI / Ollama (Required for gpt-4o or local gpt-oss:20b)
# ------------------------------------------------------------------------------
# For OpenAI API (GPT-4o):
OPENAI_API_KEY=your_openai_api_key_here

# For Local Open-Weights via Ollama (Free, no OpenAI API key required):
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=ollama
